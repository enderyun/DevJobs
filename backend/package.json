{
  "name": "devjobs-api",
  "version": "0.0.0",
  "type": "module",
  "description": "DevJobs Express API",
  "main": "src/app.ts",
  "scripts": {
    "start": "tsx src/app.ts",
    "dev": "tsx watch src/app.ts",
    "test": "NODE_ENV=test tsx --test src/app.test.ts",
    "testw": "NODE_ENV=test tsx --watch --test src/app.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=24.x"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
